# Template for `.env` — do NOT put real secrets in this file.
# Run `make env` (scripts/init-env.sh) to generate a git-ignored `.env` with
# random MySQL credentials and the matching connection URLs.

# --- MySQL credentials (generated per machine by `make env`) ---
MYSQL_ROOT_PASSWORD=__GENERATED__
USER_SVC_PASSWORD=__GENERATED__
MESSENGER_SVC_PASSWORD=__GENERATED__

# --- host runs of the services (cargo run / debugging) ---
DATABASE_URL=mysql://user_svc:<USER_SVC_PASSWORD>@127.0.0.1:3306/user_service
MESSENGER_DATABASE_URL=mysql://messenger_svc:<MESSENGER_SVC_PASSWORD>@127.0.0.1:3306/messenger_service
KAFKA_BROKERS=localhost:29092
SMTP_HOST=localhost
SMTP_PORT=1025

# --- user-service ---
SERVICE_PORT=3030
OTP_TTL_MINUTES=120
SESSION_TTL_MINUTES=10080
SESSION_CLEANUP_INTERVAL_SECONDS=3600
OUTBOX_POLL_MS=1000

# --- messenger-service ---
MESSENGER_PORT=3031
SMTP_FROM=no-reply@pattern-shop.local
SENDGRID_API_KEY=
SENDGRID_BASE_URL=https://api.sendgrid.com

# --- logging ---
RUST_LOG=info